{
  "name": "chapterize",
  "type": "module",
  "version": "0.2.27",
  "description": "Preview and split a book PDF by bookmarks or page ranges into Zotero Book Section items.",
  "config": {
    "addonName": "Chapterize",
    "addonID": "chapterize@zotero.addons",
    "addonRef": "chapterize",
    "addonInstance": "Chapterize",
    "prefsPrefix": "extensions.zotero.chapterize"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xionglingsong/zotero-chapterize.git"
  },
  "author": "Chapterize contributors",
  "bugs": {
    "url": "https://github.com/xionglingsong/zotero-chapterize/issues"
  },
  "homepage": "https://github.com/xionglingsong/zotero-chapterize#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit && node scripts/version-xpi.mjs",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/finalize-release.mjs --check",
    "release:ci": "node scripts/finalize-release.mjs --check && zotero-plugin release && node scripts/finalize-release.mjs",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
